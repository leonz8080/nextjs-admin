# =======================================
# Global ignores (all OS / editors)
# =======================================
.DS_Store
Thumbs.db
*.log

# VSCode
.vscode/

# IntelliJ / GoLand
.idea/

# =======================================
# FRONTEND (Next.js)
# =======================================
# Node modules
frontend/node_modules/

# Next.js build output
frontend/.next/
frontend/.turbo/
frontend/out/
frontend/.vercel/

# Env files
#frontend/.env
frontend/.env.*
!frontend/.env.example

# NPM / Yarn debug logs
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*

# =======================================
# BACKEND (Gin + Go)
# =======================================
backend/bin/
backend/build/
backend/dist/
backend/tmp/
backend/logs/
backend/log/

# Go cache / compiled files
backend/*.exe
backend/*.exe~
backend/*.dll
backend/*.so
backend/*.dylib
backend/*.test
backend/*.out

# Dependency lock (可选忽略)
backend/go.sum

# Env / config
#backend/.env
backend/.env.*
backend/config/local.yaml
backend/config/development.yaml

# Upload files (头像 / 文件上传目录)
backend/uploads/
backend/static/upload/

# Swagger docs (如果使用 gin-swagger)
backend/docs/

# =======================================
# Root project environment files
# =======================================
#.env
.env.*
!.env.example
