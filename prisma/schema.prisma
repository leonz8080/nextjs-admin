// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Admin {
  id           Int    @id @default(autoincrement())
  name         String
  password     String
  avatar       String?
  email        String?
  tele         String?
  address      String?
  jti          String?
  tokenHash    String?
}

model Roles {
  id           Int    @id @default(autoincrement())
  name         String
}

model AdminRole {
  id           Int    @id @default(autoincrement())
  adminId      Int
  roleId       Int
}

model RolePermission {
  id           Int    @id @default(autoincrement())
  roleId       Int
  permission   String
}

model Users {
  id           Int    @id @default(autoincrement())
  name         String
  avatar       String
  level        String
  expiration   String
  isValid      Int
  remark       String?
  status       String
}

model Notices {
  id           Int    @id @default(autoincrement())
  sendTo       Int
  avatar       String
  title        String
  content      String
  status       Int
  createAt     String
}

model Config {
  id           Int    @id @default(autoincrement())
  name         String @unique
  value        String
}